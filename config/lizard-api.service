[Unit]
Description=IoT device API server
After=network.target

[Service]
WorkingDirectory=/home/pi/lizard-button
Environment=HOME=/home/pi/lizard-button
EnvironmentFile=/home/pi/lizard-button/device.env
ExecStart=/home/pi/iot-env/bin/uvicorn api:app --host 0.0.0.0 --port 5000
Restart=always
User=pi

[Install]
WantedBy=multi-user.target