[Unit]
Description=Physical button listener for IoT device
After=network.target

[Service]
WorkingDirectory=/home/pi/lizard-button
Environment=HOME=/home/pi/lizard-button
ExecStart=/usr/bin/python3 /home/pi/lizard-button/button_listener.py
Restart=always
User=pi

[Install]
WantedBy=multi-user.target
